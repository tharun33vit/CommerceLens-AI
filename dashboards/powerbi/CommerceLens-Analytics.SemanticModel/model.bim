      {
        "name": "_Measures",
        "columns": [
          {
            "name": "_MeasureID",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "51d0f132-945a-4b0a-8095-3d5f35d4ff55",
            "sourceColumn": "_MeasureID",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "d3722be7-c7d8-48e3-9c41-dc5c2b50cbef",
        "measures": [
          {
            "name": "Total GMV",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": "CALCULATE(SUM(FactOrderItems[price]), FactOrders[order_status] = \"delivered\")",
            "formatString": "\"R$ \" #,##0.00",
            "lineageTag": "082f899c-7f5a-4f28-b676-8bc1544c7b6e"
          },
          {
            "name": "Total Merchandise Value (All Items)",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": "SUM(FactOrderItems[price])",
            "formatString": "\"R$ \" #,##0.00",
            "lineageTag": "4d82f8db-96ce-4ec7-8697-a7e97e4265da"
          },
          {
            "name": "Total Freight",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": "CALCULATE(SUM(FactOrderItems[freight_value]), FactOrders[order_status] = \"delivered\")",
            "formatString": "\"R$ \" #,##0.00",
            "lineageTag": "1ea644f2-2826-42c0-a744-11ce7868ff87"
          },
          {
            "name": "Average Order Value (AOV)",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": "DIVIDE([Total GMV], [Delivered Orders], BLANK())",
            "formatString": "\"R$ \" #,##0.00",
            "lineageTag": "61773dbe-7605-4d5c-8847-9a2977b4fdb3"
          },
          {
            "name": "Freight to Merchandise Ratio",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": "DIVIDE([Total Freight], [Total GMV], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "cb422592-27ff-4e10-98c8-cf043ee71bb9"
          },
          {
            "name": "Total Payments Collected",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": "SUM(FactPayments[payment_value])",
            "formatString": "\"R$ \" #,##0.00",
            "lineageTag": "3406d571-2edc-49c8-a69c-d8c5e4caeace"
          },
          {
            "name": "GMV MoM Growth %",
            "displayFolder": "01. Executive & Financial KPIs",
            "expression": [
              "VAR CurrentGMV = [Total GMV]",
              "VAR PreviousMonthGMV = CALCULATE([Total GMV], DATEADD(DimDate[full_date], -1, MONTH))",
              "RETURN DIVIDE(CurrentGMV - PreviousMonthGMV, PreviousMonthGMV, BLANK())"
            ],
            "formatString": "+0.00%;-0.00%;0.00%",
            "lineageTag": "50fa6d0e-5030-4d55-95cc-a7eb54041619"
          },
          {
            "name": "Total Orders",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "DISTINCTCOUNT(FactOrders[order_id])",
            "formatString": "#,##0",
            "lineageTag": "346f54ab-fd1a-48e1-ab7a-ec40b9cd960f"
          },
          {
            "name": "Delivered Orders",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"delivered\")",
            "formatString": "#,##0",
            "lineageTag": "561d65dc-b844-4f5c-b269-c61024562120"
          },
          {
            "name": "Canceled Orders",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"canceled\")",
            "formatString": "#,##0",
            "lineageTag": "f2fc59c2-ef3a-4042-9100-fe124b2340c0"
          },
          {
            "name": "Cancellation Rate",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "DIVIDE([Canceled Orders], [Total Orders], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "9c444683-0bc4-40b2-bb4c-46b4bfb4a002"
          },
          {
            "name": "Unavailable Orders",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"unavailable\")",
            "formatString": "#,##0",
            "lineageTag": "7a6c0de5-73ff-4f72-bf9b-3f764fb6a433"
          },
          {
            "name": "Unavailable Order Rate",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "DIVIDE([Unavailable Orders], [Total Orders], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "e9501637-3a90-4aa9-859a-4ef4b4dd3c74"
          },
          {
            "name": "In-Transit Orders",
            "displayFolder": "02. Order Volumes & Status",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] IN {\"shipped\", \"invoiced\", \"processing\", \"approved\", \"created\"})",
            "formatString": "#,##0",
            "lineageTag": "f9490bc8-0f94-4d93-9d50-27f2e190db3b"
          },
          {
            "name": "SLA-Eligible Orders",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE([Total Orders], FactOrders[is_eligible_for_sla] = TRUE())",
            "formatString": "#,##0",
            "lineageTag": "ffff652f-cbc8-48ee-b443-ee58cef76f52"
          },
          {
            "name": "Delivered Missing Timestamp Orders",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"delivered\", ISBLANK(FactOrders[order_delivered_customer_date]))",
            "formatString": "#,##0",
            "lineageTag": "9199ac37-0f86-475c-9d18-a6a1e5be961c"
          },
          {
            "name": "On-Time Orders",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE([Total Orders], FactOrders[is_eligible_for_sla] = TRUE(), FactOrders[is_late] = FALSE())",
            "formatString": "#,##0",
            "lineageTag": "ec88ff0a-a518-4cd0-bd32-26beb3979fd3"
          },
          {
            "name": "Late Orders",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE([Total Orders], FactOrders[is_eligible_for_sla] = TRUE(), FactOrders[is_late] = TRUE())",
            "formatString": "#,##0",
            "lineageTag": "d11686e5-f8f9-492e-9d9b-e11579781bf2"
          },
          {
            "name": "On-Time Delivery Rate",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "DIVIDE([On-Time Orders], [SLA-Eligible Orders], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "99a21cf7-df4f-4809-9f0c-f9f492e87be2"
          },
          {
            "name": "Late Delivery Rate",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "DIVIDE([Late Orders], [SLA-Eligible Orders], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "c96f8e7c-c9f8-4bad-b68e-12cb7a4bef7c"
          },
          {
            "name": "Avg Delivery Lead Time (Days)",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE(AVERAGE(FactOrders[delivery_lead_time_days]), FactOrders[is_eligible_for_sla] = TRUE())",
            "formatString": "0.00",
            "lineageTag": "53014835-f338-4dfa-b932-82def257c154"
          },
          {
            "name": "Avg Carrier Transit (Days)",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE(AVERAGE(FactOrders[carrier_transit_days]), FactOrders[is_eligible_for_sla] = TRUE())",
            "formatString": "0.00",
            "lineageTag": "8bdc4527-d6c0-4ffc-a1dc-3ba770ec3d24"
          },
          {
            "name": "Avg Seller Dispatch (Days)",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE(AVERAGE(FactOrders[seller_dispatch_days]), FactOrders[is_eligible_for_sla] = TRUE())",
            "formatString": "0.00",
            "lineageTag": "9cac2b4b-636d-40c3-a713-5bb9f0f53184"
          },
          {
            "name": "Avg SLA Variance Buffer (Days)",
            "displayFolder": "03. Logistics & SLA Operations",
            "expression": "CALCULATE(AVERAGE(FactOrders[sla_variance_days]), FactOrders[is_eligible_for_sla] = TRUE())",
            "formatString": "0.00",
            "lineageTag": "7c21a96d-f2e7-4aec-903b-b1be1b49605e"
          },
          {
            "name": "Total Reviews",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "COUNT(FactReviews[review_key])",
            "formatString": "#,##0",
            "lineageTag": "29168e7b-3d87-4eaa-8a5d-6005a77e2caa"
          },
          {
            "name": "Average Review Score",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "AVERAGE(FactReviews[review_score])",
            "formatString": "0.00",
            "lineageTag": "7d290c3c-c71f-49a0-b32b-cbccf1ebdeae"
          },
          {
            "name": "On-Time Order CSAT",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "CALCULATE([Average Review Score], FactOrders[is_eligible_for_sla] = TRUE(), FactOrders[is_late] = FALSE())",
            "formatString": "0.00",
            "lineageTag": "9761b60e-a4da-46b3-8626-908c4fc75044"
          },
          {
            "name": "Late Order CSAT",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "CALCULATE([Average Review Score], FactOrders[is_eligible_for_sla] = TRUE(), FactOrders[is_late] = TRUE())",
            "formatString": "0.00",
            "lineageTag": "b01a0502-bfdd-44db-b038-8c1b0968228b"
          },
          {
            "name": "CSAT Delivery Penalty",
            "description": "Net CSAT penalty associated with delivery SLA breaches (Late Order CSAT minus On-Time Order CSAT). Evaluates to -1.73 stars based on unrounded averages (2.566 - 4.294).",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "[Late Order CSAT] - [On-Time Order CSAT]",
            "formatString": "0.00;-0.00;0.00",
            "lineageTag": "bd406e38-6c85-43b9-b006-74a2a85dc409"
          },
          {
            "name": "CSAT Timeliness Gap",
            "description": "CSAT Timeliness Gap between on-time and late cohorts (On-Time Order CSAT minus Late Order CSAT). Represents the positive satisfaction difference (+1.73 stars) favoring on-time deliveries.",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "[On-Time Order CSAT] - [Late Order CSAT]",
            "formatString": "+0.00;-0.00;0.00",
            "lineageTag": "2a7ba7e7-5405-44d3-997c-a3c1ceb818b5"
          },
          {
            "name": "Negative Reviews Count",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "CALCULATE([Total Reviews], FactReviews[review_score] IN {1, 2})",
            "formatString": "#,##0",
            "lineageTag": "c0fb6a6a-980e-4ac1-8721-2473c3836ef6"
          },
          {
            "name": "Negative Review Share",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "DIVIDE([Negative Reviews Count], [Total Reviews], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "6a1bf33d-2f8e-467f-9be5-61735eb0a1a5"
          },
          {
            "name": "5-Star Reviews Count",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "CALCULATE([Total Reviews], FactReviews[review_score] = 5)",
            "formatString": "#,##0",
            "lineageTag": "4ab64063-f227-466e-bb62-9dd3e55b0a90"
          },
          {
            "name": "5-Star Review Share",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "DIVIDE([5-Star Reviews Count], [Total Reviews], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "45ecad6c-4d30-4709-b241-5d966f9ec6c6"
          },
          {
            "name": "Review Response Rate",
            "displayFolder": "04. Customer Review Intelligence",
            "expression": "DIVIDE(DISTINCTCOUNT(FactReviews[order_id]), [Total Orders], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "489c9ae9-2e12-4cda-ac1f-0bcbbde3e8dc"
          },
          {
            "name": "Total Unique Customers",
            "displayFolder": "05. Customer Retention & RFM",
            "expression": "DISTINCTCOUNT(DimCustomers[customer_unique_id])",
            "formatString": "#,##0",
            "lineageTag": "6c8da3a7-b642-4d1f-afbe-a0ad84431644"
          },
          {
            "name": "Repeat Customers Count",
            "displayFolder": "05. Customer Retention & RFM",
            "expression": "COUNTROWS(FILTER(VALUES(DimCustomers[customer_unique_id]), CALCULATE(DISTINCTCOUNT(FactOrders[order_id])) > 1))",
            "formatString": "#,##0",
            "lineageTag": "5f5a1fc4-9d26-4c36-a98a-336a464230fb"
          },
          {
            "name": "Repeat Customer Rate",
            "displayFolder": "05. Customer Retention & RFM",
            "expression": "DIVIDE([Repeat Customers Count], [Total Unique Customers], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "0cf16670-0e1c-471b-aeca-5502fa4a5afe"
          },
          {
            "name": "Repeat Buyer GMV",
            "displayFolder": "05. Customer Retention & RFM",
            "expression": "CALCULATE([Total GMV], FILTER(VALUES(DimCustomers[customer_unique_id]), CALCULATE(DISTINCTCOUNT(FactOrders[order_id])) > 1))",
            "formatString": "\"R$ \" #,##0.00",
            "lineageTag": "170521d7-78fe-4e4b-8226-35ff323cef0c"
          },
          {
            "name": "Repeat Buyer GMV Share",
            "displayFolder": "05. Customer Retention & RFM",
            "expression": "DIVIDE([Repeat Buyer GMV], [Total GMV], BLANK())",
            "formatString": "0.00%",
            "lineageTag": "2225cff2-1707-4ad5-8d3f-1251b05bc63f"
          },
          {
            "name": "Active Product SKUs",
            "displayFolder": "06. Category & Merchandising",
            "expression": "DISTINCTCOUNT(FactOrderItems[product_key])",
            "formatString": "#,##0",
            "lineageTag": "ec446a8d-26d4-4b8b-9cb0-e92acaec9d62"
          },
          {
            "name": "Active Sellers",
            "description": "Distinct count of active merchants fulfilling successfully delivered order transactions (2,970 active sellers out of 3,095 registered sellers).",
            "displayFolder": "06. Category & Merchandising",
            "expression": "CALCULATE(DISTINCTCOUNT(FactOrderItems[seller_key]), FactOrders[order_status] = \"delivered\")",
            "formatString": "#,##0",
            "lineageTag": "5807c148-c206-4138-9367-0491a273b573"
          },
          {
            "name": "Average Items per Order",
            "displayFolder": "06. Category & Merchandising",
            "expression": "DIVIDE(COUNT(FactOrderItems[order_item_key]), [Delivered Orders], BLANK())",
            "formatString": "0.00",
            "lineageTag": "73b88548-cc8b-45d9-b299-06925dcf88b2"
          },
          {
            "name": "Pareto Cumulative GMV %",
            "displayFolder": "06. Category & Merchandising",
            "expression": [
              "IF(",
              "    NOT(ISINSCOPE(DimProducts[category_name_english])) || ISBLANK([Total GMV]),",
              "    BLANK(),",
              "    VAR CurrentGMV = [Total GMV]",
              "    VAR CurrentCategory = SELECTEDVALUE(DimProducts[category_name_english])",
              "    VAR CategoryTable = ",
              "        ADDCOLUMNS(",
              "            ALLSELECTED(DimProducts[category_name_english]),",
              "            \"@CategoryGMV\", [Total GMV]",
              "        )",
              "    VAR FilteredTable = ",
              "        FILTER(CategoryTable, NOT(ISBLANK([@CategoryGMV])) && [@CategoryGMV] > 0)",
              "    VAR TotalSelectedGMV = SUMX(FilteredTable, [@CategoryGMV])",
              "    VAR CumulativeGMV = ",
              "        SUMX(",
              "            FILTER(",
              "                FilteredTable,",
              "                [@CategoryGMV] > CurrentGMV ||",
              "                ([@CategoryGMV] = CurrentGMV && COALESCE(DimProducts[category_name_english], \"\") <= COALESCE(CurrentCategory, \"\"))",
              "            ),",
              "            [@CategoryGMV]",
              "        )",
              "    RETURN",
              "    DIVIDE(CumulativeGMV, TotalSelectedGMV, BLANK())",
              ")"
            ],
            "formatString": "0.00%",
            "lineageTag": "dbbff9ad-72b5-4888-ab1e-2b0d49c4d860"
          },
          {
            "name": "Category GMV Share %",
            "displayFolder": "06. Category & Merchandising",
            "expression": [
              "VAR TotalMarketGMV = CALCULATE([Total GMV], ALLSELECTED(DimProducts[category_name_english]))",
              "RETURN DIVIDE([Total GMV], TotalMarketGMV, BLANK())"
            ],
            "formatString": "0.00%",
            "lineageTag": "d0882cde-a1ab-4a83-96d9-9569a94387ff"
          },
          {
            "name": "Delivered Orders (Category)",
            "description": "Distinct count of delivered orders containing products in the selected category. Category-aware measure operating at the FactOrderItems grain with delivered-order filtering.",
            "displayFolder": "06. Category & Merchandising",
            "expression": "CALCULATE(DISTINCTCOUNT(FactOrderItems[order_id]), FactOrders[order_status] = \"delivered\")",
            "formatString": "#,##0",
            "lineageTag": "a0000000-0000-0000-0000-000000000048"
          },
          {
            "name": "Total Sellers",
            "description": "Total registered marketplace sellers cataloged in DimSellers (3,095 total sellers).",
            "displayFolder": "06. Category & Merchandising",
            "expression": "DISTINCTCOUNT(DimSellers[seller_key])",
            "formatString": "#,##0",
            "lineageTag": "a0000000-0000-0000-0000-000000000049"
          },
          {
            "name": "Completed Review Analyses Count",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(FactReviewAnalysis[ReviewOrderKey]),",
              "    REMOVEFILTERS(FactReviewAnalysis[status]),",
              "    FactReviewAnalysis[status] = \"completed\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "64fcc898-367a-43a5-8e28-8e23e66fc1b7"
          },
          {
            "name": "Failed Review Analyses Count",
            "expression": [
              "",
              "COALESCE(",
              "    CALCULATE(",
              "        DISTINCTCOUNT(FactReviewAnalysis[ReviewOrderKey]),",
              "        REMOVEFILTERS(FactReviewAnalysis[status]),",
              "        FactReviewAnalysis[status] = \"failed\"",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "150acac0-f9e8-4a55-8b47-60a9a6348225"
          },
          {
            "name": "Eligible Text Reviews Count",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(FactReviews[ReviewOrderKey]),",
              "    FILTER(",
              "        ALL(FactReviews),",
              "        LEN(TRIM(COALESCE(FactReviews[review_comment_title], \"\"))) > 0",
              "            || LEN(TRIM(COALESCE(FactReviews[review_comment_message], \"\"))) > 0",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "68094085-3dd9-4ed1-a91a-0b5039a6bb7b"
          },
          {
            "name": "Review Intelligence Pilot Coverage %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Completed Review Analyses Count],",
              "    [Eligible Text Reviews Count],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "f3c06428-8cd2-4b7b-9d9b-11d05f2bea0c"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [_MeasureID = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"_MeasureID\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
