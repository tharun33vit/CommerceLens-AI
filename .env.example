# ==============================================================================
# CommerceLens AI - Environment Configuration Template
# Copy this file to .env and supply your local / production values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commercelens_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SCHEMA=public

# SQLAlchemy Connection URI (constructed automatically if left blank)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/commercelens_db

# ------------------------------------------------------------------------------
# LLM & AI Provider Settings (Configured in Phase 5 & 6)
# ------------------------------------------------------------------------------
# Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Supported Gemini Model Selection:
# - gemini-3.5-flash-lite: high-throughput candidate with minimal thinking (no custom temperature) [Preferred]
# - gemini-3.8-flash: baseline production model with low thinking level (code fallback when unset)
# Safe dry-run command (inspects eligible reviews without making API calls or persisting rows):
#   python scripts/run_review_intelligence.py --dry-run
#   python scripts/run_review_intelligence.py --dry-run --model gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=2048

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ------------------------------------------------------------------------------
# Data Directory Paths (Defaults point to relative project data folders)
# ------------------------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
REPORTS_DIR=reports
